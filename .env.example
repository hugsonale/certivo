#############################################################################
# Certivo Environment Configuration Template
# 
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Update values below with your actual configuration
#   3. NEVER commit .env to git (it's in .gitignore)
#############################################################################

# ===== ADMIN AUTHENTICATION =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_NOW_min_16_chars
ADMIN_SECRET_KEY=GENERATE_64_CHAR_RANDOM_STRING_HERE

# Generate secret key with:
# python3 -c "import secrets; print(secrets.token_hex(32))"

# ===== DATABASE =====
DATABASE_URL=sqlite:///certivo_v2.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://certivouser:password@localhost/certivo

# ===== SECURITY =====
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# For development (localhost):
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

MAX_UPLOAD_SIZE=10485760
RATE_LIMIT_ENABLED=true

# ===== ENVIRONMENT =====
ENVIRONMENT=production

# Options: development, staging, production

# ===== MONITORING (Optional) =====
SENTRY_DSN=

# Get from: https://sentry.io/
# Example: https://abc123@o123456.ingest.sentry.io/123456

ENABLE_METRICS=true
LOG_LEVEL=INFO

# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===== EMAIL (Optional - for alerts) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@yourdomain.com

# ===== CLOUD STORAGE (Optional) =====
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=certivo-backups
# AWS_REGION=us-east-1

# ===== REDIS (Optional - for caching) =====
# REDIS_URL=redis://localhost:6379/0

# ===== APPLICATION =====
APP_NAME=Certivo
APP_VERSION=1.0.0
DEBUG=false

# Set to true ONLY in development