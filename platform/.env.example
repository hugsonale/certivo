# Copy to .env (never commit .env). All variables use the CERTIVO_ prefix.
CERTIVO_ENV=dev
CERTIVO_DATABASE_URL=sqlite:///./certivo_dev.db
# Dev only: apply database migrations automatically at startup. Ignored unless CERTIVO_ENV=dev.
CERTIVO_AUTO_MIGRATE=true
# 32-byte Ed25519 seed, base64url. Generate with: python scripts/gen_signing_key.py
# Required when CERTIVO_ENV=prod. In dev an ephemeral key is generated per process.
# docker compose also reads this value from this file.
CERTIVO_ATTESTATION_SIGNING_KEY=
CERTIVO_ATTESTATION_KEY_ID=att-dev-1

# --- Abuse protection (docs/spec/base/01 and 02). Every number is a PLACEHOLDER; see platform/README.md ---
# Browser origins allowed to call the SDK endpoints: comma separated, exact https://host origins.
CERTIVO_CORS_ALLOWED_ORIGINS=
# How many reverse proxies sit in front of the service. 0 = none. Set this correctly in production.
CERTIVO_TRUSTED_PROXY_HOPS=0
# Uncomment to change a limit:
# CERTIVO_SDK_TOKEN_TTL_SECONDS=21600
# CERTIVO_RATE_LIMIT_KEY_PER_MINUTE=600
# CERTIVO_RATE_LIMIT_SESSION_PER_MINUTE=1800
# CERTIVO_RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=20
# CERTIVO_MAX_BODY_BYTES=65536
# CERTIVO_BODY_READ_TIMEOUT_S=10
# CERTIVO_DB_STATEMENT_TIMEOUT_MS=5000
# CERTIVO_MAX_API_KEYS_PER_PARTNER=50
# Outage tolerance (P0-08): a late upload or a hole in scores longer than this is disclosed as a gap.
# CERTIVO_GAP_DISCLOSURE_THRESHOLD_MS=10000
# Retention (P0-09). Deliberately NO default: how long to keep data is a privacy/legal decision.
# Until CERTIVO_SCORE_EVENT_RETENTION_DAYS is set, the maintenance job deletes nothing.
# CERTIVO_SCORE_EVENT_RETENTION_DAYS=
# CERTIVO_ATTESTATION_RETENTION_DAYS=   (must be longer than the score-event period when set)
# CERTIVO_PARTITION_DAYS_AHEAD=7

# --- Webhooks (docs/spec/base/05). Numbers are PLACEHOLDERS ---
# Key that encrypts webhook signing secrets. Required unless CERTIVO_ENV=dev. Generate with:
#   python scripts/gen_webhook_key.py
CERTIVO_WEBHOOK_SECRET_KEY=
# Where the Celery worker finds Redis.
CERTIVO_REDIS_URL=redis://localhost:6379/0
# DEV ONLY: allow webhooks to localhost, so you can test against your own PC.
# CERTIVO_WEBHOOK_ALLOW_PRIVATE_TARGETS=true
# CERTIVO_WEBHOOK_RETRY_DELAYS_S=30,300,1800,7200,21600,43200
# CERTIVO_WEBHOOK_TIMEOUT_S=10
# CERTIVO_WEBHOOK_POLL_INTERVAL_S=5
# Attestation signing (P0-10). Production MUST use a managed key service and must not set a key here.
# CERTIVO_ATTESTATION_SIGNER=aws_kms
# CERTIVO_ATTESTATION_KMS_KEY_ID=alias/certivo-attestations
# CERTIVO_ATTESTATION_KMS_REGION=eu-west-2
# CERTIVO_ATTESTATION_KEY_ID=att-2026-10   (a new, never-used id for every key)
# CERTIVO_ATTESTATION_RETRY_MAX_WAIT_S=60
